---
// Thanh đầu trang dùng chung của Molli: logo, điều hướng, nút nhắn Zalo, nút giao diện góc phải.
import { zaloLink } from '../data/molli';
interface Props {
	active?: 'home' | 'blog' | 'about';
}
const { active } = Astro.props;
const links = [
	{ key: 'products', href: '/#san-pham', label: 'Sản phẩm' },
	{ key: 'stages', href: '/#giai-doan', label: 'Theo giai đoạn' },
	{ key: 'wholesale', href: '/#dai-ly', label: 'Đại lý' },
	{ key: 'blog', href: '/blog/', label: 'Cẩm nang' },
	{ key: 'about', href: '/about/', label: 'Về Molli' },
	{ key: 'contact', href: '/#lien-he', label: 'Liên hệ' },
];
---

<a class="skip" href="#noi-dung">Đến nội dung chính</a>
<header class="topbar">
	<div class="wrap nav">
		<a class="brand" href="/" aria-label="Molli, về trang chủ">
			<img src="/images/molli/logo.webp" alt="Molli - More Love, More Care" width="520" height="230" />
		</a>
		<nav class="navlinks" aria-label="Điều hướng chính">
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={{ active: link.key === active }}
						aria-current={link.key === active ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>
		<a class="nav-cta" href={zaloLink} target="_blank" rel="noopener">Nhắn Zalo tư vấn</a>
		<div class="theme">
			<span id="theme-icon" aria-hidden="true">◐</span>
			<label for="theme-mode" class="sr-only">Chọn giao diện</label>
			<select id="theme-mode">
				<option value="auto">Tự động</option>
				<option value="light">Sáng</option>
				<option value="dark">Tối</option>
			</select>
		</div>
	</div>
</header>

<script is:inline>
	(() => {
		const select = document.getElementById('theme-mode');
		const icon = document.getElementById('theme-icon');
		if (!select) return;
		const valid = (v) => (['light', 'dark', 'auto'].includes(v) ? v : 'auto');
		select.value = valid(document.documentElement.dataset.mode);
		const resolve = (mode, hour) => (mode === 'auto' ? (hour >= 6 && hour < 18 ? 'light' : 'dark') : mode);
		const apply = () => {
			const mode = valid(select.value);
			const theme = resolve(mode, new Date().getHours());
			document.documentElement.dataset.theme = theme;
			document.documentElement.dataset.mode = mode;
			if (icon) icon.textContent = theme === 'dark' ? '☾' : '☀';
		};
		select.addEventListener('change', () => {
			try {
				localStorage.setItem('molli-theme', select.value);
			} catch {}
			apply();
		});
		apply();
		setInterval(apply, 60000);
		document.addEventListener('visibilitychange', () => {
			if (!document.hidden) apply();
		});
		window.addEventListener('storage', (e) => {
			if (e.key === 'molli-theme') {
				select.value = valid(e.newValue);
				apply();
			}
		});
	})();
</script>
