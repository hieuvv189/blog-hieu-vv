---
// Thanh đầu trang dùng chung, khớp với trang chủ: logo, điều hướng, nút giao diện góc phải.
interface Props {
	active?: 'home' | 'blog' | 'about';
}
const { active } = Astro.props;
const links = [
	{ key: 'home', href: '/', label: 'Trang chủ' },
	{ key: 'blog', href: '/blog/', label: 'Bài viết' },
	{ key: 'notes', href: '/#ghi-chu', label: 'Ghi chú' },
	{ key: 'about', href: '/about/', label: 'Về tôi' },
];
---

<a class="skip" href="#noi-dung">Đến nội dung chính</a>
<header class="topbar">
	<div class="wrap nav">
		<a class="brand" href="/" aria-label="Hiếu VV, trang chủ">
			<span class="brand-mark" aria-hidden="true"></span><span>hiếu vv<span class="brand-dot">.</span></span>
			<small>Một góc nhìn, nhiều câu chuyện.</small>
		</a>
		<nav class="navlinks" aria-label="Điều hướng chính">
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={{ active: link.key === active }}
						aria-current={link.key === active ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>
		<div class="theme">
			<span id="theme-icon" aria-hidden="true">◐</span>
			<label for="theme-mode" class="sr-only">Chọn giao diện</label>
			<select id="theme-mode">
				<option value="auto">Tự động</option>
				<option value="light">Sáng</option>
				<option value="dark">Tối</option>
			</select>
		</div>
	</div>
</header>

<script is:inline>
	(() => {
		const select = document.getElementById('theme-mode');
		const icon = document.getElementById('theme-icon');
		if (!select) return;
		const valid = (v) => (['light', 'dark', 'auto'].includes(v) ? v : 'auto');
		select.value = valid(document.documentElement.dataset.mode);
		const resolve = (mode, hour) => (mode === 'auto' ? (hour >= 6 && hour < 18 ? 'light' : 'dark') : mode);
		const apply = () => {
			const mode = valid(select.value);
			const theme = resolve(mode, new Date().getHours());
			document.documentElement.dataset.theme = theme;
			document.documentElement.dataset.mode = mode;
			if (icon) icon.textContent = theme === 'dark' ? '☾' : '☀';
		};
		select.addEventListener('change', () => {
			try {
				localStorage.setItem('hieuvv-theme', select.value);
			} catch {}
			apply();
		});
		apply();
		setInterval(apply, 60000);
		document.addEventListener('visibilitychange', () => {
			if (!document.hidden) apply();
		});
		window.addEventListener('storage', (e) => {
			if (e.key === 'hieuvv-theme') {
				select.value = valid(e.newValue);
				apply();
			}
		});
	})();
</script>
