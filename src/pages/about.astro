---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const latest = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const topics = [
	{ tone: 'tile', title: 'Kinh doanh', text: 'Bán hàng, chăm khách, vận hành một thương hiệu nhỏ và những bài học trả giá mới có.' },
	{ tone: 'blue', title: 'Sáng tạo & công nghệ', text: 'Công cụ, tự động hóa và cách để máy làm việc lặp lại, người dành thời gian để nghĩ.' },
	{ tone: 'peach', title: 'Cuộc sống', text: 'Thói quen, những khoảng nghỉ và các ghi chép nhỏ từ một ngày bình thường.' },
];

const principles = [
	'Viết từ trải nghiệm thật, không viết để trông có vẻ hiểu biết.',
	'Ngắn khi có thể, đủ sâu khi cần.',
	'Không quảng cáo, không giật tít, không vội vàng.',
];
---

<!doctype html>
<html lang="vi" data-theme="light">
	<head>
		<BaseHead
			title={`Về tôi · ${SITE_TITLE}`}
			description="Đôi điều về Hiếu VV: người làm kinh doanh, xây sản phẩm và viết để nghĩ rõ hơn."
			image="/blog-placeholder-about.jpg"
		/>
		<style>
			.intro {
				display: grid;
				grid-template-columns: 1.2fr 0.8fr;
				gap: 72px;
				align-items: center;
				padding: 64px 0 56px;
			}
			.intro h1 {
				font-size: clamp(34px, 4.2vw, 52px);
				font-weight: 650;
				letter-spacing: -2.2px;
				line-height: 1.25;
				margin: 20px 0 22px;
			}
			.intro h1 em {
				font-style: normal;
				color: var(--accent);
			}
			.intro p {
				color: var(--muted);
				line-height: 1.95;
				max-width: 520px;
				margin: 0 0 14px;
			}
			.portrait {
				position: relative;
				height: 320px;
				background: var(--tile);
				border-radius: 16px 16px 120px 120px;
				overflow: hidden;
				display: grid;
				place-items: center;
			}
			.portrait .sun {
				position: absolute;
				width: 70px;
				height: 70px;
				border-radius: 50%;
				background: var(--peach);
				top: 34px;
				right: 40px;
			}
			.portrait .ring {
				position: absolute;
				width: 180px;
				height: 180px;
				border: 1px solid var(--accent);
				opacity: 0.25;
				border-radius: 50%;
				left: -60px;
				bottom: 20px;
			}
			.monogram {
				width: 132px;
				height: 132px;
				border-radius: 50%;
				background: var(--accent);
				color: var(--bg);
				display: grid;
				place-items: center;
				font-size: 46px;
				font-weight: 800;
				letter-spacing: -2px;
				position: relative;
			}
			.portrait small {
				position: absolute;
				bottom: 18px;
				left: 0;
				right: 0;
				text-align: center;
				font-size: 9px;
				letter-spacing: 1.5px;
				color: var(--accent);
			}
			.block {
				padding: 48px 0;
				border-top: 1px solid var(--line);
			}
			.block-grid {
				display: grid;
				grid-template-columns: 260px 1fr;
				gap: 56px;
			}
			.block h2 {
				font-size: 21px;
				letter-spacing: -0.6px;
				font-weight: 650;
				margin: 0;
			}
			.block .lead {
				font-size: 12px;
				color: var(--muted);
				margin: 8px 0 0;
			}
			.topics {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 16px;
			}
			.topic {
				border-radius: 14px;
				padding: 22px;
				background: var(--tile);
			}
			.topic.blue {
				background: var(--blue);
			}
			.topic.peach {
				background: var(--peach);
			}
			.topic h3 {
				font-size: 16px;
				font-weight: 650;
				margin: 0 0 8px;
			}
			.topic p {
				font-size: 13px;
				line-height: 1.8;
				margin: 0;
			}
			.principles {
				list-style: none;
				margin: 0;
				padding: 0;
				counter-reset: p;
			}
			.principles li {
				counter-increment: p;
				display: grid;
				grid-template-columns: 44px 1fr;
				padding: 14px 0;
				border-bottom: 1px solid var(--line);
				font-size: 16px;
			}
			.principles li:first-child {
				padding-top: 0;
			}
			.principles li::before {
				content: '0' counter(p);
				color: var(--accent);
				font-weight: 650;
				font-size: 13px;
				padding-top: 3px;
			}
			.latest {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.latest a {
				display: flex;
				justify-content: space-between;
				gap: 20px;
				padding: 14px 0;
				border-bottom: 1px solid var(--line);
			}
			.latest li:first-child a {
				padding-top: 0;
			}
			.latest a:hover strong {
				color: var(--accent);
			}
			.latest strong {
				font-weight: 600;
				transition: color 0.2s;
			}
			.latest .meta {
				white-space: nowrap;
			}
			.cta {
				margin-top: 8px;
				padding: 32px;
				background: var(--soft);
				border-radius: var(--radius);
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 24px;
			}
			.cta h2 {
				font-size: 22px;
				font-weight: 600;
				letter-spacing: -0.6px;
				margin: 0 0 6px;
			}
			.cta p {
				margin: 0;
				font-size: 13px;
				color: var(--muted);
			}
			.cta-actions {
				display: flex;
				gap: 12px;
				flex-wrap: wrap;
			}
			@media (max-width: 850px) {
				.intro {
					gap: 36px;
				}
				.block-grid {
					grid-template-columns: 1fr;
					gap: 22px;
				}
			}
			@media (max-width: 620px) {
				.intro {
					grid-template-columns: 1fr;
					padding: 40px 0;
					gap: 30px;
				}
				.portrait {
					height: 230px;
					border-radius: 14px 14px 80px 80px;
				}
				.monogram {
					width: 100px;
					height: 100px;
					font-size: 36px;
				}
				.topics {
					grid-template-columns: 1fr;
				}
				.latest a {
					flex-direction: column;
					gap: 4px;
				}
				.cta {
					flex-direction: column;
					align-items: flex-start;
					padding: 26px;
				}
			}
		</style>
	</head>
	<body>
		<Header active="about" />
		<main id="noi-dung" class="wrap">
			<section class="intro" aria-labelledby="about-title">
				<div>
					<div class="eyebrow"><span class="dot"></span>Về tôi</div>
					<h1 id="about-title">Chào bạn, tôi là <em>Hiếu.</em></h1>
					<p>
						Tôi làm kinh doanh, xây dựng sản phẩm cho mẹ và bé, và dành nhiều thời gian để tìm cách
						làm việc gọn hơn nhờ công nghệ.
					</p>
					<p>
						Blog này là cuốn sổ mở của tôi. Không phải câu trả lời cuối cùng, mà là những điều đang
						học: viết ra để nghĩ rõ hơn, chia sẻ để cùng đi xa hơn.
					</p>
				</div>
				<div class="portrait" role="img" aria-label="Minh họa phẳng: chữ H trong vòng tròn xanh, cạnh một mặt trời">
					<div class="sun"></div>
					<div class="ring"></div>
					<div class="monogram">H.</div>
					<small>LÀM VIỆC CÓ TÂM. SỐNG CÓ GÓC NHÌN.</small>
				</div>
			</section>

			<section class="block" aria-labelledby="topics-title">
				<div class="block-grid">
					<div>
						<h2 id="topics-title">Tôi viết về điều gì</h2>
						<p class="lead">Ba mạch chính, đan vào nhau.</p>
					</div>
					<div class="topics">
						{
							topics.map((t) => (
								<div class:list={['topic', t.tone]}>
									<h3>{t.title}</h3>
									<p>{t.text}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<section class="block" aria-labelledby="principles-title">
				<div class="block-grid">
					<div>
						<h2 id="principles-title">Cách tôi viết</h2>
						<p class="lead">Ba nguyên tắc cho mỗi bài.</p>
					</div>
					<ol class="principles">
						{principles.map((p) => <li>{p}</li>)}
					</ol>
				</div>
			</section>

			{
				latest.length > 0 && (
					<section class="block" aria-labelledby="latest-title">
						<div class="block-grid">
							<div>
								<h2 id="latest-title">Bắt đầu từ đây</h2>
								<p class="lead">Những bài viết gần nhất.</p>
							</div>
							<ul class="latest">
								{latest.map((post) => (
									<li>
										<a href={`/blog/${post.id}/`}>
											<strong>{post.data.title}</strong>
											<span class="meta">
												<FormattedDate date={post.data.pubDate} />
											</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					</section>
				)
			}

			<section class="cta" aria-labelledby="cta-title">
				<div>
					<h2 id="cta-title">Cùng đọc, cùng nghĩ.</h2>
					<p>Theo dõi những trang viết tiếp theo qua RSS, hoặc ghé xem mã nguồn của blog này.</p>
				</div>
				<div class="cta-actions">
					<a class="primary" href="/rss.xml">Theo dõi qua RSS <span aria-hidden="true">↗</span></a>
					<a class="ghost" href="https://github.com/hieuvv189/blog-hieu-vv" rel="noopener">GitHub</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
