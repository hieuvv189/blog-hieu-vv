---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CONTACT, callLink, formatPhone, zaloLink } from '../data/molli';

const latest = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const values = [
	{
		title: 'More Love',
		text: 'Mỗi món đồ Molli làm là một việc nhỏ giúp mẹ bớt lo, để có thêm thời gian ôm con.',
	},
	{
		title: 'More Care',
		text: 'Chọn chất liệu kỹ, ghi rõ quy cách và độ tuổi dùng, để mẹ mua đúng thứ bé cần.',
	},
	{
		title: 'Luôn có người trả lời',
		text: 'Nhắn Zalo là có Molli tư vấn 24/7. Việc cần người thật xử lý được làm trong giờ 8h-21h.',
	},
];
---

<!doctype html>
<html lang="vi" data-theme="light">
	<head>
		<BaseHead
			title="Về Molli · More Love - More Care"
			description="Molli là thương hiệu phụ kiện cho mẹ và bé, phân phối bởi Công ty TNHH Thương mại Vinabi Việt Nam."
		/>
		<style>
			.h-display {
				font-family: 'Baloo 2', 'Be Vietnam Pro', sans-serif;
				font-weight: 800;
				letter-spacing: -0.5px;
			}
			.intro {
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				gap: 64px;
				align-items: center;
				padding: 56px 0;
			}
			.intro h1 {
				font-size: clamp(34px, 4.4vw, 54px);
				line-height: 1.1;
				margin: 18px 0 20px;
			}
			.intro h1 em {
				font-style: normal;
				color: var(--brand);
			}
			:root[data-theme='dark'] .intro h1 em {
				color: var(--accent);
			}
			.intro p {
				color: var(--muted);
				line-height: 1.85;
				max-width: 540px;
				margin: 0 0 14px;
			}
			.art {
				border-radius: 28px;
				overflow: hidden;
				background: linear-gradient(160deg, #cfe6f8, #a9d1f2);
				aspect-ratio: 1 / 1;
				box-shadow: 18px 18px 0 var(--pink);
			}
			.art img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.block {
				padding: 48px 0;
				border-top: 1px solid var(--line);
			}
			.block h2 {
				font-size: clamp(26px, 3vw, 34px);
				margin: 0 0 22px;
			}
			.values {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 18px;
			}
			.values article {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 18px;
				padding: 24px;
			}
			.values h3 {
				margin: 0 0 8px;
				font-size: 18px;
				color: var(--brand);
			}
			:root[data-theme='dark'] .values h3 {
				color: var(--accent);
			}
			.values p {
				margin: 0;
				color: var(--muted);
				font-size: 14px;
				line-height: 1.7;
			}
			.cats {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
			}
			.cats a {
				border: 1px solid var(--line);
				background: var(--surface);
				border-radius: 999px;
				padding: 9px 18px;
				font-size: 14px;
				font-weight: 600;
			}
			.cats a:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.info {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 18px;
			}
			.info div {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 18px;
				padding: 22px 24px;
				font-size: 14.5px;
				line-height: 1.8;
			}
			.info small {
				display: block;
				font-size: 12px;
				font-weight: 700;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 1px;
				margin-bottom: 6px;
			}
			.latest {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 2px;
			}
			.latest a {
				display: flex;
				justify-content: space-between;
				gap: 18px;
				padding: 14px 0;
				border-bottom: 1px solid var(--line);
				font-weight: 600;
			}
			.latest a:hover {
				color: var(--accent);
			}
			.cta {
				margin: 24px 0 72px;
				background: var(--brand-deep);
				color: #fff;
				border-radius: 24px;
				padding: 36px 40px;
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				align-items: center;
				gap: 20px;
			}
			.cta h2 {
				margin: 0;
				font-size: clamp(24px, 2.8vw, 32px);
			}
			.cta p {
				margin: 6px 0 0;
				color: #dcebf7;
			}
			.cta-actions {
				display: flex;
				gap: 12px;
				flex-wrap: wrap;
			}
			.cta-actions a {
				border-radius: 999px;
				padding: 12px 22px;
				font-weight: 700;
				font-size: 14px;
				background: #fff;
				color: #1f5f8f;
			}
			.cta-actions a + a {
				background: transparent;
				color: #fff;
				border: 1.5px solid rgba(255, 255, 255, 0.5);
			}
			@media (max-width: 860px) {
				.intro {
					grid-template-columns: 1fr;
					gap: 36px;
				}
				.art {
					max-width: 420px;
				}
				.values,
				.info {
					grid-template-columns: 1fr;
				}
				.cta {
					padding: 28px 24px;
				}
			}
		</style>
	</head>
	<body>
		<Header active="about" />
		<main id="noi-dung" class="wrap">
			<section class="intro" aria-labelledby="about-title">
				<div>
					<div class="eyebrow"><span class="dot"></span>Về Molli</div>
					<h1 id="about-title" class="h-display">More Love, <em>More Care.</em></h1>
					<p>
						Molli là thương hiệu phụ kiện cho mẹ và bé. Molli làm những món nhỏ mẹ dùng mỗi ngày: túi trữ sữa, gạc rơ
						lưỡi, tăm bông, lót chống thấm, khăn và chăn cho bé.
					</p>
					<p>
						Chú thỏ má hồng của Molli nhắc tụi mình một điều: đồ cho bé phải dễ thương, nhưng trước hết phải dễ dùng và
						rõ ràng. Hiện Molli có hơn 50 mã, bán lẻ trên Shopee và giao sỉ cho cửa hàng mẹ và bé.
					</p>
				</div>
				<div class="art">
					<img src="/images/molli/tho-vay-chao.webp" alt="Thỏ Molli vẫy tay chào" width="900" height="900" />
				</div>
			</section>

			<section class="block" aria-labelledby="values-title">
				<h2 id="values-title" class="h-display">Molli giữ ba điều</h2>
				<div class="values">
					{
						values.map((v) => (
							<article>
								<h3>{v.title}</h3>
								<p>{v.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="block" aria-labelledby="cats-title">
				<h2 id="cats-title" class="h-display">Molli có gì</h2>
				<div class="cats">
					{CATEGORIES.map((c) => <a href="/#san-pham">{c.label}</a>)}
				</div>
			</section>

			<section class="block" aria-labelledby="info-title">
				<h2 id="info-title" class="h-display">Thông tin liên hệ</h2>
				<div class="info">
					<div>
						<small>Nhập khẩu và phân phối</small>
						{CONTACT.company}<br />
						{CONTACT.address}
					</div>
					<div>
						<small>Liên hệ</small>
						Zalo tư vấn 24/7: <a href={zaloLink} target="_blank" rel="noopener">{formatPhone(CONTACT.zaloPhone)}</a><br />
						Gọi đơn sỉ, hợp tác: <a href={callLink}>{formatPhone(CONTACT.callPhone)}</a>
					</div>
				</div>
			</section>

			{
				latest.length > 0 && (
					<section class="block" aria-labelledby="latest-title">
						<h2 id="latest-title" class="h-display">Cẩm nang mới</h2>
						<ul class="latest">
							{latest.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span>{post.data.title}</span>
										<span class="meta">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<section class="cta" aria-labelledby="cta-title">
				<div>
					<h2 id="cta-title" class="h-display">Mẹ cần tư vấn chọn đồ cho bé?</h2>
					<p>Nhắn Molli qua Zalo, có người trả lời cả ngày lẫn đêm.</p>
				</div>
				<div class="cta-actions">
					<a href={zaloLink} target="_blank" rel="noopener">Nhắn Zalo</a>
					<a href={CONTACT.shopee} target="_blank" rel="noopener">Mua trên Shopee ↗</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
