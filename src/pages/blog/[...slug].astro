---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { readingMinutes } from '../../utils/reading';

export async function getStaticPaths() {
	// Sắp xếp mới nhất trước: "Bài trước" là bài cũ hơn, "Bài sau" là bài mới hơn.
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return posts.map((post, i) => {
		const older = posts[i + 1];
		const newer = posts[i - 1];
		return {
			params: { slug: post.id },
			props: {
				post,
				prev: older ? { id: older.id, title: older.data.title } : undefined,
				next: newer ? { id: newer.id, title: newer.data.title } : undefined,
			},
		};
	});
}

type Props = {
	post: CollectionEntry<'blog'>;
	prev?: { id: string; title: string };
	next?: { id: string; title: string };
};

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} minutes={readingMinutes(post.body)} prev={prev} next={next}>
	<Content />
</BlogPost>
