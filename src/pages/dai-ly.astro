---
// Trang thông tin cho cửa hàng muốn làm đại lý / nhà phân phối Molli.
// Chỉ ghi chính sách đã chốt (memory molli-trong-tam-dai-ly), không đưa giá đại lý lên web.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DealerForm from '../components/DealerForm.astro';
import { CONTACT, callLink, formatPhone, zaloLink } from '../data/molli';

const benefits = [
	{ icon: '💰', title: 'Giá cả cạnh tranh', text: 'Giá theo bậc số lượng của từng mã, nhập càng nhiều giá càng tốt.' },
	{ icon: '🧾', title: 'Nguồn gốc rõ ràng', text: 'Hoá đơn, chứng từ đầy đủ. Mã nào có giấy kiểm định, Molli gửi kèm.' },
	{ icon: '🚚', title: 'Hỗ trợ cước vận chuyển', text: 'Miễn cước cho đơn từ 10 triệu, nội thành Hà Nội từ 3 triệu.' },
	{ icon: '🔁', title: 'Đổi, trả linh hoạt', text: 'Hàng lỗi được đổi mới trong 3 ngày kể từ khi nhận.' },
	{ icon: '⚡', title: 'Giao hàng tức thì', text: 'Miền Bắc gửi xe nhận trong ngày, miền Trung và Nam đi SPX.' },
	{ icon: '🐰', title: 'Dễ bán, khách quay lại', text: 'Hơn 50 mã đồ dùng hằng ngày cho mẹ và bé, dùng hết là mẹ quay lại mua.' },
];

const steps = [
	{ title: 'Để lại tên cửa hàng và số điện thoại', text: 'Điền form bên dưới hoặc nhắn Zalo cho Molli.' },
	{ title: 'Nhận bảng giá và tư vấn mã', text: 'Molli gửi bảng giá theo bậc, gợi ý mã hợp với khu vực của anh chị.' },
	{ title: 'Chốt đơn, chuyển khoản, nhận hàng', text: 'Đơn tối thiểu 1,5 triệu (gồm VAT). Chuyển khoản tài khoản công ty trước khi đi hàng.' },
];
---

<!doctype html>
<html lang="vi" data-theme="light">
	<head>
		<BaseHead
			title="Đại lý / Nhà phân phối Molli · Nhập đồ sơ sinh cho cửa hàng mẹ và bé"
			description="Chính sách nhập sỉ Molli cho cửa hàng mẹ và bé: giá cạnh tranh, hoá đơn chứng từ đầy đủ, hỗ trợ cước, đổi trả linh hoạt, giao nhanh."
		/>
		<style>
			:root {
				--h: #24618f;
				--chip: #e8f3fb;
			}
			:root[data-theme='dark'] {
				--h: #cfe6f7;
				--chip: #1b3248;
			}
			.tag {
				display: inline-block;
				background: var(--chip);
				color: var(--accent);
				font-weight: 700;
				font-size: 13px;
				padding: 6px 14px;
				border-radius: 99px;
				margin-bottom: 12px;
				letter-spacing: 0;
				text-transform: none;
			}
			h1,
			h2 {
				color: var(--h);
			}
			.hero {
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 48px;
				align-items: center;
				padding: 56px 0 40px;
			}
			.hero h1 {
				font-size: clamp(32px, 4vw, 46px);
				line-height: 1.15;
				margin: 0 0 16px;
			}
			.hero p {
				color: var(--muted);
				font-size: 17px;
				line-height: 1.8;
				margin: 0 0 24px;
				max-width: 540px;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				padding: 12px 24px;
				border-radius: 99px;
				font-weight: 700;
				border: 2px solid var(--brand);
			}
			.btn.solid {
				background: var(--brand);
				color: #fff;
			}
			.btn.line {
				color: var(--accent);
			}
			.art {
				border-radius: 28px;
				overflow: hidden;
				background: linear-gradient(160deg, #cfe6f8, #a9d1f2);
				aspect-ratio: 1 / 1;
				max-width: 420px;
				justify-self: center;
				width: 100%;
			}
			.art img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.block {
				padding: 48px 0;
				border-top: 1px solid var(--line);
			}
			.block h2 {
				font-size: clamp(26px, 3vw, 32px);
				margin: 0 0 24px;
			}
			.benefits {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 18px;
			}
			.benefits article {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 18px;
				padding: 24px;
			}
			.benefits .ic {
				font-size: 28px;
				line-height: 1;
			}
			.benefits h3 {
				margin: 12px 0 6px;
				font-size: 18px;
				color: var(--h);
			}
			.benefits p {
				margin: 0;
				color: var(--muted);
				font-size: 15px;
				line-height: 1.7;
			}
			.steps {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 18px;
				counter-reset: s;
			}
			.steps li {
				counter-increment: s;
				padding: 24px;
				border-radius: 18px;
				background: var(--chip);
			}
			.steps li::before {
				content: counter(s);
				display: grid;
				place-items: center;
				width: 36px;
				height: 36px;
				border-radius: 50%;
				background: var(--brand);
				color: #fff;
				font-weight: 800;
				margin-bottom: 12px;
			}
			.steps b {
				display: block;
				font-size: 17px;
				margin-bottom: 6px;
			}
			.steps span {
				color: var(--muted);
				font-size: 15px;
				line-height: 1.7;
			}
			.signup {
				background: linear-gradient(135deg, #3a87c0 0%, #24618f 100%);
				color: #fff;
				border-radius: 28px;
				padding: 44px;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 40px;
				align-items: center;
				margin: 48px 0 64px;
			}
			.signup h2 {
				color: #fff;
				margin: 0 0 12px;
				font-size: clamp(26px, 3vw, 32px);
			}
			.signup p {
				color: #dcecf9;
				margin: 0 0 8px;
				line-height: 1.75;
			}
			.signup a {
				color: #fff;
				font-weight: 800;
			}
			@media (max-width: 900px) {
				.hero,
				.signup {
					grid-template-columns: 1fr;
				}
				.benefits,
				.steps {
					grid-template-columns: 1fr 1fr;
				}
				.art {
					max-width: 300px;
				}
			}
			@media (max-width: 560px) {
				.benefits,
				.steps {
					grid-template-columns: 1fr;
				}
				.signup {
					padding: 26px;
				}
				.hero {
					padding-top: 32px;
				}
			}
		</style>
	</head>
	<body>
		<Header active="wholesale" />
		<main id="noi-dung" class="wrap">
			<section class="hero" aria-labelledby="dl-title">
				<div>
					<span class="tag">Đại lý / Nhà phân phối</span>
					<h1 id="dl-title">Nhập Molli cho cửa hàng mẹ và bé của anh chị</h1>
					<p>
						Molli là thương hiệu đồ sơ sinh do {CONTACT.company} phát triển và phân phối. Cửa hàng, đại lý và nhà phân phối
						trên toàn quốc đều có thể nhập trực tiếp từ công ty.
					</p>
					<div class="actions">
						<a class="btn solid" href="#dang-ky">Nhận bảng giá</a>
						<a class="btn line" href={zaloLink} target="_blank" rel="noopener">Nhắn Zalo tư vấn</a>
					</div>
				</div>
				<div class="art">
					<img src="/images/molli/tho-om-tim.webp" alt="Thỏ Molli ôm trái tim" width="900" height="900" />
				</div>
			</section>

			<section class="block" aria-labelledby="dl-benefits">
				<h2 id="dl-benefits">Nhập hàng cùng Molli, anh chị có gì?</h2>
				<div class="benefits">
					{
						benefits.map((b) => (
							<article>
								<div class="ic" aria-hidden="true">
									{b.icon}
								</div>
								<h3>{b.title}</h3>
								<p>{b.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="block" aria-labelledby="dl-steps">
				<h2 id="dl-steps">Ba bước để bắt đầu</h2>
				<ol class="steps">
					{
						steps.map((s) => (
							<li>
								<b>{s.title}</b>
								<span>{s.text}</span>
							</li>
						))
					}
				</ol>
			</section>

			<section class="signup" id="dang-ky" aria-labelledby="dl-signup">
				<div>
					<h2 id="dl-signup">Nhận bảng giá đại lý / nhà phân phối</h2>
					<p>Chỉ cần tên cửa hàng và số điện thoại. Molli tư vấn 24/7, đơn hàng được xử lý trong giờ 8h-21h.</p>
					<p>
						Cần gấp, anh chị gọi <a href={callLink}>{formatPhone(CONTACT.callPhone)}</a> hoặc nhắn
						<a href={zaloLink} target="_blank" rel="noopener">Zalo {formatPhone(CONTACT.zaloPhone)}</a>.
					</p>
				</div>
				<DealerForm id="dealer-form-page" title="Để lại thông tin cửa hàng" />
			</section>
		</main>
		<Footer />
	</body>
</html>
