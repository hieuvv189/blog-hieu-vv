---
// Trang chi tiết từng mã sản phẩm Molli: /san-pham/mol3019/.
// Chỉ dùng dữ liệu đã có trong src/data/molli.ts (giá lẻ, quy cách, ghi chú, giấy kiểm định, video feedback).
// Không đưa giá đại lý lên web.
import { REAL_PHOTOS, PRODUCT_AGES } from '../../data/product-details';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
	CATEGORIES,
	paperPagesOf,
	PRODUCTS,
	type Product,
	formatPrice,
	imageOf,
	productUrl,
	shopeeLink,
	videosOf,
	zaloLink,
} from '../../data/molli';

export function getStaticPaths() {
	return PRODUCTS.map((p) => ({ params: { code: p.code.toLowerCase() }, props: { product: p } }));
}

const { product: p } = Astro.props as { product: Product };
const photos = REAL_PHOTOS[p.code] ?? [];
const gallery = [...new Set([imageOf(p.code), ...photos])];
const age = PRODUCT_AGES[p.code] ?? 'Nhắn Molli để xác nhận độ tuổi phù hợp';
const cat = CATEGORIES.find((c) => c.key === p.cat)!;
const papers = paperPagesOf(p.code);
const paper = papers.length > 0;
const videos = videosOf(p.code);
const related = PRODUCTS.filter((x) => x.cat === p.cat && x.code !== p.code).slice(0, 4);
const title = `${p.name} ${p.spec.split(' · ')[0]} · ${p.code} · Molli`;
const description = `${p.name} Molli ${p.code}, ${p.spec}. ${p.note} Giá lẻ ${formatPrice(p.price)}. Tư vấn Zalo 24/7.`;
---

<!doctype html>
<html lang="vi" data-theme="light">
	<head>
		<BaseHead title={title} description={description} image={imageOf(p.code)} />
		<style>
			.crumbs {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
				font-size: 14px;
				color: var(--muted);
				padding: 24px 0 8px;
			}
			.crumbs a {
				color: var(--accent);
				text-decoration: none;
			}
			.detail {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
				gap: 48px;
				align-items: start;
				padding: 16px 0 48px;
			}
			.photo {
				background: #fff;
				border: 1px solid var(--line);
				border-radius: 24px;
				overflow: hidden;
			}
			.photo img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 1;
				object-fit: contain;
			}
            [data-product-gallery] { min-width: 0; }
            .gallery-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
            .gallery-track::-webkit-scrollbar { display: none; }
            .gallery-slide { flex: 0 0 100%; min-width: 0; scroll-snap-align: start; }
            .gallery-controls { display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: 12px; }
            .gallery-controls button { width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; background: white; color: var(--accent); font-size: 26px; cursor: pointer; }
            .gallery-controls button:disabled { opacity: .35; cursor: default; }
            .gallery-thumbs { display: flex; gap: 8px; overflow-x: auto; padding: 10px 2px; }
            .gallery-thumbs button { flex: 0 0 64px; padding: 2px; border: 2px solid var(--line); border-radius: 10px; background: white; cursor: pointer; }
            .gallery-thumbs button[aria-pressed="true"] { border-color: var(--accent); }
            .gallery-thumbs img { width: 100%; height: 60px; object-fit: contain; display: block; }
            .gallery-hint { text-align: center; color: var(--muted); font-size: 13px; }
			.code {
				display: inline-block;
				background: #e8f3fb;
				color: var(--accent);
				font-weight: 700;
				font-size: 13px;
				padding: 6px 14px;
				border-radius: 99px;
			}
			.detail h1 {
				color: #24618f;
				font-size: clamp(28px, 3.4vw, 40px);
				line-height: 1.2;
				margin: 14px 0 10px;
			}
			.spec {
				color: var(--muted);
				font-size: 16px;
				margin: 0;
			}
			.price {
				font-size: 32px;
				font-weight: 800;
				color: var(--price, #e0533d);
				margin: 20px 0 4px;
			}
			.price-note {
				font-size: 13px;
				color: var(--muted);
				margin: 0 0 20px;
			}
			.info {
				list-style: none;
				padding: 18px 20px;
				margin: 0 0 24px;
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 18px;
				display: grid;
				gap: 10px;
				font-size: 15.5px;
				line-height: 1.6;
			}
			.info b {
				color: #24618f;
			}
			.buy {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
			}
			.buy a {
				flex: 1 1 180px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 54px;
				box-sizing: border-box;
				text-align: center;
				white-space: nowrap;
				font-weight: 700;
				line-height: 1.25;
				padding: 12px 20px;
				border-radius: 99px;
				border: 2px solid transparent;
				text-decoration: none;
				font-size: 16px;
			}
			.buy .z {
				background: var(--brand);
				border-color: var(--brand);
				color: #fff;
			}
			@media (max-width: 520px) {
				.buy a {
					flex-basis: 100%;
				}
			}
			.buy .s {
				background: #fff1ec;
				color: #d6461f;
				border: 2px solid #f7c8b8;
			}
			.promise {
				display: flex;
				flex-wrap: wrap;
				gap: 8px 18px;
				margin: 18px 0 0;
				padding: 0;
				list-style: none;
				font-size: 14px;
				color: var(--muted);
			}
			.promise a {
				color: var(--accent);
				font-weight: 700;
			}
			.block {
				padding: 40px 0;
				border-top: 1px solid var(--line);
			}
			.block h2 {
				color: #24618f;
				font-size: clamp(22px, 2.6vw, 28px);
				margin: 0 0 20px;
			}
			.papers {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
				gap: 16px;
				max-width: 820px;
			}
			.papers a {
				border: 1px solid var(--line);
				border-radius: 14px;
				overflow: hidden;
				background: #fff;
			}
			.papers img {
				display: block;
				width: 100%;
				height: auto;
			}
			.paper-note {
				margin: 14px 0 0;
				color: var(--muted);
				line-height: 1.7;
			}
			.vids {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(200px, 240px));
				gap: 16px;
			}
			.vids video {
				width: 100%;
				aspect-ratio: 9 / 16;
				object-fit: cover;
				border-radius: 16px;
				background: #dfeaf3;
				display: block;
			}
			.vids p {
				font-size: 14px;
				color: var(--muted);
				margin: 8px 0 0;
				line-height: 1.5;
			}
			.related {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 16px;
			}
			.related a {
				display: flex;
				flex-direction: column;
				border: 1px solid var(--line);
				border-radius: 18px;
				overflow: hidden;
				background: var(--surface);
				text-decoration: none;
				color: inherit;
				transition: 0.2s;
			}
			.related a:hover {
				box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
			}
			.related img {
				width: 100%;
				height: auto;
				aspect-ratio: 1;
				object-fit: cover;
				display: block;
			}
			.related span {
				padding: 10px 14px 0;
				font-size: 12px;
				font-weight: 700;
				color: var(--accent);
			}
			.related h3 {
				font-size: 15px;
				margin: 2px 14px 4px;
				line-height: 1.35;
			}
			.related b {
				margin: auto 14px 14px;
				color: var(--price, #e0533d);
			}
			.back {
				display: inline-block;
				margin-top: 24px;
				color: var(--accent);
				font-weight: 700;
				text-decoration: none;
			}
			@media (max-width: 860px) {
				.detail {
					grid-template-columns: 1fr;
					gap: 24px;
				}
				.related {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.papers {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.vids {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="noi-dung" class="wrap">
			<nav class="crumbs" aria-label="Đường dẫn">
				<a href="/">Trang chủ</a><span aria-hidden="true">›</span>
				<a href="/#san-pham">Sản phẩm</a><span aria-hidden="true">›</span>
				<span>{cat.label}</span>
			</nav>

			<section class="detail" aria-labelledby="sp-title">
                <div data-product-gallery>
                    <div class="photo gallery-track" tabindex="0" role="region" aria-label={`Ảnh sản phẩm ${p.code}, vuốt để xem thêm`}>
                        {gallery.map((src, i) => (
                            <a class="gallery-slide" href={src} target="_blank" rel="noopener" aria-label={`Phóng to ảnh ${i + 1} của ${p.name}`}>
                                <img src={src} alt={`${p.name} ${p.code}, ảnh ${i + 1}`} width="560" height="560" loading={i === 0 ? 'eager' : 'lazy'} />
                            </a>
                        ))}
                    </div>
                    {gallery.length > 1 && <>
                        <div class="gallery-controls">
                            <button type="button" data-gallery-prev aria-label="Ảnh trước">‹</button>
                            <span data-gallery-count aria-live="polite">1 / {gallery.length}</span>
                            <button type="button" data-gallery-next aria-label="Ảnh tiếp theo">›</button>
                        </div>
                        <div class="gallery-thumbs" aria-label="Chọn ảnh sản phẩm">
                            {gallery.map((src, i) => <button type="button" data-gallery-index={i} aria-label={`Xem ảnh ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}><img src={src} alt="" width="64" height="64" loading="lazy" /></button>)}
                        </div>
                        <p class="gallery-hint">Vuốt ngang để xem thêm ảnh · Bấm ảnh để phóng to</p>
                    </>}
                </div>
				<div>
					<span class="code">{p.code} · {cat.label}</span>
					<h1 id="sp-title">{p.name}</h1>
					<p class="spec">{p.spec}</p>
					<div class="price">{formatPrice(p.price)}</div>
					<p class="price-note">Giá bán lẻ khuyến nghị, cập nhật 13/11/2026. Giá trên Shopee có thể khác khi shop chạy chương trình.</p>
					<ul class="info">
						<li><b>Quy cách:</b> {p.spec}</li>
						<li><b>Độ tuổi sử dụng:</b> {age}</li>
						<li><b>Đặc điểm:</b> {p.note}</li>
						<li><b>Nhóm hàng:</b> {cat.label}</li>
						{paper && <li><b>Giấy kiểm định:</b> có, xem ở phía dưới.</li>}
					</ul>
					<div class="buy">
						<a class="s" href={shopeeLink(p.code)} target="_blank" rel="noopener">Mua ngay trên Shopee</a>
						<a class="z" href={zaloLink} target="_blank" rel="noopener">Tư vấn qua Zalo</a>
					</div>
					<ul class="promise">
						<li>Lỗi là đổi, trong 3 ngày</li>
						<li>Molli luôn ở đây 24/7</li>
						<li>Cửa hàng nhập sỉ: <a href="/dai-ly/">xem chính sách đại lý</a></li>
					</ul>
				</div>
			</section>



			{
				paper && (
					<section class="block" aria-labelledby="sp-paper">
						<h2 id="sp-paper">Giấy kiểm định của mã này</h2>
						<div class="papers">
							{papers.map((pg) => (
								<a href={pg.src} target="_blank" rel="noopener" aria-label={`Mở to ${pg.alt}`}>
									<img src={pg.src} alt={pg.alt} width="400" height="565" loading="lazy" />
								</a>
							))}
						</div>
						<p class="paper-note">
							{papers.length > 1 ? `Ảnh chụp bản gốc, ${papers.length} trang. ` : ''}Bấm vào từng trang để xem to. Mẹ cần bản đầy đủ thì nhắn Zalo, Molli gửi ngay.
						</p>
					</section>
				)
			}

			{
				videos.length > 0 && (
					<section class="block" aria-labelledby="sp-videos">
						<h2 id="sp-videos">Video thật từ các mẹ</h2>
						<div class="vids">
							{videos.map((v) => (
								<div>
									<video
										src={`/videos/feedback/${v.slug}.mp4`}
										poster={`/videos/feedback/${v.slug}.webp`}
										controls
										playsinline
										preload="none"
										aria-label={`Video feedback ${v.label} Molli`}
									/>
									<p>{v.text}</p>
								</div>
							))}
						</div>
					</section>
				)
			}

			{
				related.length > 0 && (
					<section class="block" aria-labelledby="sp-related">
						<h2 id="sp-related">Cùng nhóm {cat.label}</h2>
						<div class="related">
							{related.map((r) => (
								<a href={productUrl(r.code)}>
									<img src={imageOf(r.code)} alt={`${r.name} Molli ${r.code}`} width="560" height="560" loading="lazy" />
									<span>{r.code}</span>
									<h3>{r.name}</h3>
									<b>{formatPrice(r.price)}</b>
								</a>
							))}
						</div>
						<a class="back" href="/#san-pham">← Xem tất cả sản phẩm</a>
					</section>
				)
			}
		</main>
        <script>
            document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
                const track = gallery.querySelector<HTMLElement>('.gallery-track')!;
                const slides = Array.from(track.children);
                const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-index]'));
                const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
                const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
                const count = gallery.querySelector<HTMLElement>('[data-gallery-count]');
                let current = 0;
                const update = () => {
                    current = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / track.clientWidth)));
                    if (count) count.textContent = `${current + 1} / ${slides.length}`;
                    if (prev) prev.disabled = current === 0;
                    if (next) next.disabled = current === slides.length - 1;
                    thumbs.forEach((button, i) => button.setAttribute('aria-pressed', String(i === current)));
                };
                const go = (index: number) => {
                    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
                    track.scrollTo({left: Math.max(0, Math.min(slides.length - 1, index)) * track.clientWidth, behavior: reduced ? 'instant' : 'smooth'});
                };
                prev?.addEventListener('click', () => go(current - 1));
                next?.addEventListener('click', () => go(current + 1));
                thumbs.forEach((button, i) => button.addEventListener('click', () => go(i)));
                track.addEventListener('scroll', update, {passive: true});
                track.addEventListener('keydown', (event) => {
                    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
                        event.preventDefault(); go(current + (event.key === 'ArrowRight' ? 1 : -1));
                    }
                });
                new ResizeObserver(() => { track.scrollLeft = current * track.clientWidth; update(); }).observe(track);
                update();
            });
        </script>
		<Footer />
	</body>
</html>
