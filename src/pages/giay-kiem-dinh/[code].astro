---
// Trang giấy kiểm định của một mã: /giay-kiem-dinh/mol3019/. Hiện từng trang giấy cỡ lớn, bấm để phóng to.
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CATEGORIES, PRODUCTS, type Product, imageOf, paperLookupUrl, paperPagesOf, productUrl, zaloLink } from '../../data/molli';

export function getStaticPaths() {
	return PRODUCTS.filter((p) => paperPagesOf(p.code).length > 0).map((p) => ({
		params: { code: p.code.toLowerCase() },
		props: { product: p },
	}));
}

const { product: p } = Astro.props as { product: Product };
const pages = paperPagesOf(p.code);
const cat = CATEGORIES.find((c) => c.key === p.cat)!;
const siblings = PRODUCTS.filter((x) => x.cat === p.cat && x.code !== p.code && paperPagesOf(x.code).length > 0);
---

<!doctype html>
<html lang="vi" data-theme="light">
	<head>
		<BaseHead
			title={`Giấy kiểm định ${p.name} ${p.code} · Molli`}
			description={`Ảnh chụp bản gốc ${pages.length} trang giấy chứng nhận, phiếu thử nghiệm của ${p.name} Molli ${p.code} (${p.spec}).`}
			image={pages[0].src}
		/>
		<style>
			.crumbs { display: flex; flex-wrap: wrap; gap: 6px; font-size: 14px; color: var(--muted); padding: 24px 0 8px; }
			.crumbs a { color: var(--accent); text-decoration: none; }
			.head { display: flex; gap: 20px; align-items: center; padding: 8px 0 24px; }
			.head img { width: 96px; height: 96px; object-fit: contain; background: #fff; border: 1px solid var(--line); border-radius: 18px; flex: none; }
			.head .code { color: var(--accent); font-weight: 700; font-size: 14px; }
			.head h1 { color: #24618f; font-size: clamp(22px, 3vw, 32px); margin: 4px 0; }
			.head p { color: var(--muted); margin: 0; }
			.head .links { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 10px; }
			.head .links a { color: var(--accent); font-weight: 700; font-size: 14px; }
			.note { color: var(--muted); line-height: 1.7; margin: 0 0 20px; max-width: 760px; }
			.pages { display: grid; gap: 24px; max-width: 860px; margin: 0; padding: 0; list-style: none; }
			.pages figure { margin: 0; }
			.pages button { display: block; width: 100%; padding: 0; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: #fff; cursor: zoom-in; }
			.pages img { display: block; width: 100%; height: auto; }
			.pages figcaption { color: var(--muted); font-size: 14px; margin-top: 8px; }
			.more { padding: 40px 0 56px; border-top: 1px solid var(--line); margin-top: 40px; }
			.more h2 { color: #24618f; font-size: 22px; margin: 0 0 14px; }
			.more ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 20px; padding: 0; list-style: none; }
			.more li a { display: inline-block; padding: 6px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--line); color: var(--accent); font-size: 14px; text-decoration: none; }
			.back { color: var(--accent); font-weight: 700; }
			.zoom { border: 0; padding: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; background: rgba(10, 25, 40, 0.92); }
			.zoom::backdrop { background: rgba(10, 25, 40, 0.92); }
			.zoom .scroll { width: 100%; height: 100%; overflow: auto; display: grid; place-items: start center; }
			.zoom img { display: block; width: min(1100px, 100%); height: auto; margin: 0 auto; }
			.zoom .bar { position: fixed; top: 12px; right: 12px; display: flex; gap: 8px; }
			.zoom .bar button, .zoom .bar a { background: #fff; color: #24618f; border: 0; border-radius: 999px; padding: 8px 14px; font: inherit; font-size: 14px; font-weight: 700; cursor: pointer; text-decoration: none; }
			@media (max-width: 600px) {
				.head { align-items: flex-start; }
				.head img { width: 72px; height: 72px; }
			}
		</style>
	</head>
	<body>
		<Header active="papers" />
		<main id="noi-dung" class="wrap">
			<nav class="crumbs" aria-label="Đường dẫn">
				<a href="/">Trang chủ</a><span aria-hidden="true">›</span>
				<a href="/giay-kiem-dinh/">Giấy kiểm định</a><span aria-hidden="true">›</span>
				<a href={`/giay-kiem-dinh/#${cat.key}`}>{cat.label}</a><span aria-hidden="true">›</span>
				<span>{p.code}</span>
			</nav>
			<section class="head" aria-labelledby="gk-title">
				<img src={imageOf(p.code)} alt={`${p.name} ${p.code}`} width="96" height="96" />
				<div>
					<span class="code">{p.code} · {cat.label}</span>
					<h1 id="gk-title">Giấy kiểm định {p.name}</h1>
					<p>{p.spec}</p>
					<div class="links">
						<a href={productUrl(p.code)}>Xem sản phẩm ›</a>
						<a href={zaloLink} target="_blank" rel="noopener">Hỏi Molli qua Zalo ›</a>
					</div>
				</div>
			</section>
			<p class="note">
				Ảnh chụp bản gốc, {pages.length} trang. Bấm vào từng trang để phóng to. Phạm vi mã và lô hàng theo phụ lục; kết quả thử nghiệm áp dụng cho mẫu ghi trong phiếu.
			</p>
			<ol class="pages">
				{pages.map((pg, i) => (
					<li>
						<figure>
							<button type="button" data-zoom={pg.src} aria-label={`Phóng to trang ${i + 1}: ${pg.alt}`}>
								<img src={pg.src} alt={pg.alt} width="860" height="1216" loading={i < 2 ? 'eager' : 'lazy'} />
							</button>
							<figcaption>Trang {i + 1}/{pages.length} · {pg.alt}</figcaption>
						</figure>
					</li>
				))}
			</ol>

			<section class="more" aria-labelledby="gk-more">
				{siblings.length > 0 && <>
					<h2 id="gk-more">Giấy tờ khác cùng nhóm {cat.label}</h2>
					<ul>
						{siblings.map((s) => <li><a href={paperLookupUrl(s.code)}>{s.name} · {s.code}</a></li>)}
					</ul>
				</>}
				<a class="back" href="/giay-kiem-dinh/">← Về mục lục giấy kiểm định</a>
			</section>
		</main>
		<dialog class="zoom" aria-label="Xem giấy phóng to" data-zoom-dialog>
			<div class="scroll"><img alt="" data-zoom-img /></div>
			<div class="bar">
				<a href="#" target="_blank" rel="noopener" data-zoom-open>Mở ảnh gốc</a>
				<button type="button" data-zoom-close>Đóng ✕</button>
			</div>
		</dialog>
		<script>
			const dialog = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]')!;
			const img = dialog.querySelector<HTMLImageElement>('[data-zoom-img]')!;
			const open = dialog.querySelector<HTMLAnchorElement>('[data-zoom-open]')!;
			document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) => {
				btn.addEventListener('click', () => {
					img.src = btn.dataset.zoom!;
					img.alt = btn.querySelector('img')?.alt ?? '';
					open.href = btn.dataset.zoom!;
					dialog.showModal();
				});
			});
			dialog.querySelector('[data-zoom-close]')!.addEventListener('click', () => dialog.close());
			dialog.addEventListener('click', (e) => { if (e.target === dialog || (e.target as HTMLElement).classList.contains('scroll')) dialog.close(); });
		</script>
		<Footer />
	</body>
</html>
