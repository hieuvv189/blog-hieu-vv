---
// Trang chủ Molli. Bố cục tham khảo cuonsinh.com: hero + dải thông tin, 4 lý do,
// sản phẩm theo nhóm, gợi ý theo giai đoạn (thay cho combo), dải nhập sỉ, liên hệ.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION } from '../consts';
import {
	BUNDLES,
	CATEGORIES,
	CONTACT,
	PRODUCTS,
	STAGES,
	callLink,
	formatPhone,
	formatPrice,
	imageOf,
	zaloLink,
} from '../data/molli';

const catLabel = Object.fromEntries(CATEGORIES.map((c) => [c.key, c.label]));
const heroProduct = PRODUCTS.find((p) => p.code === 'MOL3015')!;

const pillars = [
	{
		icon: '🧺',
		title: 'Chọn kỹ chất liệu',
		text: 'Bông, cotton, sợi tre, silicon. Mỗi mã ghi rõ chất liệu và độ tuổi phù hợp để mẹ dễ chọn.',
	},
	{
		icon: '🏷️',
		title: 'Rõ ràng',
		text: 'Giá niêm yết, quy cách đóng gói ghi đủ trên từng mã. Mua đúng thứ mình cần, không đoán.',
	},
	{
		icon: '🍼',
		title: 'Đủ món cho mỗi giai đoạn',
		text: 'Từ túi đồ đi sinh, những tháng đầu sơ sinh, mẹ cho con bú đến lúc bé tập ăn dặm.',
	},
	{
		icon: '💬',
		title: 'Có người trả lời',
		text: 'Nhắn Zalo là có Molli tư vấn 24/7. Việc cần người thật xử lý được làm trong giờ 8h-21h.',
	},
];

const bundles = BUNDLES.map((b) => ({ ...b, total: b.items.reduce((s, i) => s + i.price, 0) }));
---

<!doctype html>
<html lang="vi" data-theme="light">
	<head>
		<BaseHead title="Molli · Phụ kiện cho mẹ và bé · More Love - More Care" description={SITE_DESCRIPTION} />
		<style>
			.h-display {
				font-family: 'Baloo 2', 'Be Vietnam Pro', sans-serif;
				font-weight: 800;
				letter-spacing: -0.5px;
			}
			/* Hero */
			.hero {
				display: grid;
				grid-template-columns: 1.05fr 0.95fr;
				gap: 64px;
				align-items: center;
				padding: 56px 0 48px;
			}
			.kicker {
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 1.6px;
				text-transform: uppercase;
				color: var(--price);
			}
			.hero h1 {
				font-size: clamp(38px, 5vw, 62px);
				line-height: 1.08;
				margin: 16px 0 20px;
			}
			.hero h1 em {
				font-style: normal;
				color: var(--brand);
				display: block;
			}
			:root[data-theme='dark'] .hero h1 em {
				color: var(--accent);
			}
			.hero p {
				color: var(--muted);
				font-size: 16px;
				line-height: 1.8;
				max-width: 520px;
				margin: 0;
			}
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin: 28px 0 22px;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				border-radius: 999px;
				padding: 13px 24px;
				font-size: 14px;
				font-weight: 700;
				border: 1.5px solid transparent;
			}
			.btn-main {
				background: var(--brand);
				color: #fff;
			}
			:root[data-theme='dark'] .btn-main {
				background: var(--accent);
				color: #0f1d2a;
			}
			.btn-line {
				border-color: var(--line);
				background: var(--surface);
			}
			.btn-line:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.status {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				background: var(--soft);
				border-radius: 999px;
				padding: 7px 14px;
				font-size: 12.5px;
				font-weight: 600;
			}
			.status i {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: #1f9d57;
			}
			.status[data-open='false'] i {
				background: #e0a020;
			}
			.hero-art {
				position: relative;
				padding: 0 22px 22px 0;
			}
			.hero-art::before {
				content: '';
				position: absolute;
				inset: 22px 0 0 22px;
				background: var(--pink);
				border-radius: 28px;
			}
			.hero-frame {
				position: relative;
				border-radius: 28px;
				overflow: hidden;
				aspect-ratio: 1 / 1;
				background: linear-gradient(160deg, #cfe6f8, #a9d1f2);
			}
			.hero-frame img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.hero-chip {
				position: absolute;
				left: -18px;
				bottom: 54px;
				display: flex;
				gap: 12px;
				align-items: center;
				background: var(--surface);
				border-radius: 16px;
				padding: 10px 16px 10px 10px;
				box-shadow: 0 10px 30px rgba(23, 52, 76, 0.16);
				font-size: 13px;
				font-weight: 600;
				line-height: 1.4;
			}
			.hero-chip img {
				width: 52px;
				height: 52px;
				border-radius: 10px;
				object-fit: cover;
			}
			.hero-chip b {
				display: block;
				color: var(--price);
				font-size: 15px;
			}
			/* Dải thông tin */
			.facts {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				border: 1px solid var(--line);
				border-radius: 18px;
				background: var(--surface);
				overflow: hidden;
			}
			.facts div {
				padding: 20px 22px;
				border-left: 1px solid var(--line);
			}
			.facts div:first-child {
				border-left: 0;
			}
			.facts b {
				display: block;
				font-size: 17px;
			}
			.facts span {
				font-size: 12.5px;
				color: var(--muted);
			}
			/* Khối chung */
			.sec {
				padding: 80px 0;
			}
			.sec-alt {
				background: var(--soft);
			}
			.sec-head {
				margin-bottom: 30px;
				max-width: 640px;
			}
			.sec-head h2 {
				font-size: clamp(28px, 3.4vw, 40px);
				line-height: 1.15;
				margin: 8px 0 8px;
			}
			.sec-head p {
				color: var(--muted);
				margin: 0;
			}
			.pillars {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 18px;
			}
			.pillar {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 18px;
				padding: 24px;
			}
			.pillar .ic {
				width: 46px;
				height: 46px;
				border-radius: 14px;
				background: var(--tile);
				display: grid;
				place-items: center;
				font-size: 22px;
				margin-bottom: 16px;
			}
			.pillar h3 {
				margin: 0 0 8px;
				font-size: 17px;
			}
			.pillar p {
				margin: 0;
				color: var(--muted);
				font-size: 13.5px;
				line-height: 1.7;
			}
			/* Sản phẩm */
			.tabs {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				margin-bottom: 24px;
			}
			.tabs button {
				border: 1px solid var(--line);
				background: var(--surface);
				border-radius: 999px;
				padding: 8px 16px;
				font-size: 13px;
				font-weight: 600;
			}
			.tabs button[aria-pressed='true'] {
				background: var(--brand);
				border-color: var(--brand);
				color: #fff;
			}
			:root[data-theme='dark'] .tabs button[aria-pressed='true'] {
				background: var(--accent);
				border-color: var(--accent);
				color: #0f1d2a;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 18px;
			}
			.card {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 18px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.15s, box-shadow 0.15s;
			}
			.card:hover {
				transform: translateY(-3px);
				box-shadow: 0 12px 28px rgba(23, 52, 76, 0.1);
			}
			.card img {
				width: 100%;
				aspect-ratio: 1 / 1;
				object-fit: cover;
				display: block;
				background: #fff;
			}
			.card-body {
				padding: 14px 16px 18px;
				display: flex;
				flex-direction: column;
				gap: 4px;
				flex: 1;
			}
			.pill {
				align-self: flex-start;
				font-size: 11px;
				font-weight: 700;
				color: var(--accent);
				background: var(--tile);
				border-radius: 999px;
				padding: 2px 10px;
			}
			.card h3 {
				font-size: 15px;
				line-height: 1.4;
				margin: 6px 0 0;
			}
			.card .spec {
				font-size: 12.5px;
				color: var(--muted);
			}
			.card .price {
				margin-top: auto;
				padding-top: 8px;
				display: flex;
				justify-content: space-between;
				align-items: baseline;
			}
			.card .price b {
				color: var(--price);
				font-size: 17px;
			}
			.card .price small {
				font-size: 11px;
				color: var(--muted);
			}
			.below {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 18px;
				margin-top: 28px;
			}
			.below p {
				margin: 0;
				font-size: 12.5px;
				color: var(--muted);
				max-width: 560px;
			}
			/* Gợi ý theo giai đoạn */
			.stages {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 12px;
				margin-bottom: 22px;
				max-width: 720px;
			}
			.stages button {
				background: var(--surface);
				border: 1.5px solid var(--line);
				border-radius: 14px;
				padding: 12px 10px;
				font-size: 14px;
				font-weight: 700;
			}
			.stages button[aria-pressed='true'] {
				border-color: var(--price);
				background: var(--pink);
				color: var(--ink);
			}
			.bundles {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 18px;
			}
			.bundle {
				background: var(--surface);
				border: 1px solid var(--line);
				border-top: 4px solid var(--brand);
				border-radius: 18px;
				padding: 24px 26px;
				display: flex;
				flex-direction: column;
			}
			.bundle:nth-child(even) {
				border-top-color: var(--price);
			}
			.bundle small {
				font-size: 11.5px;
				font-weight: 700;
				letter-spacing: 1px;
				text-transform: uppercase;
				color: var(--muted);
			}
			.bundle h3 {
				margin: 4px 0 2px;
				font-size: 21px;
			}
			.bundle .total {
				color: var(--price);
				font-size: 22px;
				font-weight: 800;
			}
			.bundle .total span {
				font-size: 12px;
				color: var(--muted);
				font-weight: 500;
				margin-left: 6px;
			}
			.bundle ul {
				list-style: none;
				padding: 0;
				margin: 14px 0 20px;
				display: grid;
				gap: 8px;
				font-size: 14px;
			}
			.bundle li {
				display: flex;
				justify-content: space-between;
				gap: 12px;
			}
			.bundle li::before {
				content: '✓';
				color: var(--brand);
				font-weight: 800;
				margin-right: 8px;
			}
			.bundle li span:first-child {
				flex: 1;
			}
			.bundle li span:last-child {
				color: var(--muted);
				white-space: nowrap;
			}
			.bundle .btn {
				margin-top: auto;
				align-self: flex-start;
				padding: 10px 18px;
				font-size: 13px;
			}
			.fine {
				font-size: 12.5px;
				color: var(--muted);
				margin: 18px 0 0;
			}
			/* Dải nhập sỉ */
			.wholesale {
				background: var(--brand-deep);
				color: #fff;
			}
			.ws-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 56px;
				align-items: center;
			}
			.wholesale .kicker {
				color: #ffd3e2;
			}
			.wholesale h2 {
				font-size: clamp(28px, 3.4vw, 40px);
				line-height: 1.15;
				margin: 8px 0 14px;
			}
			.wholesale p {
				color: #dcebf7;
				margin: 0 0 12px;
			}
			.wholesale .btn-main {
				background: #fff;
				color: #1f5f8f;
				margin-top: 10px;
			}
			.ws-stats {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 14px;
			}
			.ws-stats div {
				border: 1px solid rgba(255, 255, 255, 0.22);
				background: rgba(255, 255, 255, 0.06);
				border-radius: 16px;
				padding: 20px;
			}
			.ws-stats b {
				display: block;
				font-family: 'Baloo 2', sans-serif;
				font-size: 34px;
				line-height: 1.1;
			}
			.ws-stats span {
				font-size: 13px;
				color: #dcebf7;
			}
			/* Liên hệ */
			.contact {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 18px;
			}
			.contact a {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 18px;
				padding: 22px;
				display: flex;
				flex-direction: column;
				gap: 4px;
			}
			.contact a:hover {
				border-color: var(--accent);
			}
			.contact small {
				font-size: 12px;
				color: var(--muted);
				font-weight: 600;
			}
			.contact b {
				font-size: 17px;
			}
			.contact span {
				font-size: 13px;
				color: var(--muted);
			}
			.company {
				margin-top: 22px;
				font-size: 13.5px;
				color: var(--muted);
			}
			@media (max-width: 960px) {
				.hero {
					grid-template-columns: 1fr;
					gap: 40px;
				}
				.hero-art {
					max-width: 460px;
					margin: 0 auto;
					width: 100%;
				}
				.facts,
				.pillars,
				.grid,
				.contact {
					grid-template-columns: repeat(2, 1fr);
				}
				.facts div:nth-child(3) {
					border-left: 0;
				}
				.facts div:nth-child(n + 3) {
					border-top: 1px solid var(--line);
				}
				.ws-grid {
					grid-template-columns: 1fr;
					gap: 32px;
				}
			}
			@media (max-width: 620px) {
				.hero {
					padding: 32px 0 36px;
				}
				.hero p {
					font-size: 15px;
				}
				.hero-chip {
					left: 10px;
					bottom: 34px;
				}
				.sec {
					padding: 56px 0;
				}
				.pillars {
					grid-template-columns: 1fr;
				}
				.grid {
					gap: 12px;
				}
				.card-body {
					padding: 12px;
				}
				.card h3 {
					font-size: 14px;
				}
				.tabs {
					flex-wrap: nowrap;
					overflow-x: auto;
					margin-right: -18px;
					padding-bottom: 4px;
				}
				.tabs button {
					white-space: nowrap;
				}
				.stages {
					grid-template-columns: 1fr 1fr;
				}
				.bundles,
				.contact {
					grid-template-columns: 1fr;
				}
				.bundle {
					padding: 20px;
				}
				.facts div {
					padding: 16px;
				}
			}
		</style>
	</head>
	<body>
		<Header active="home" />
		<main id="noi-dung">
			<div class="wrap">
				<section class="hero" aria-labelledby="hero-title">
					<div>
						<span class="kicker">Phụ kiện cho mẹ và bé · Từ đi sinh đến ăn dặm</span>
						<h1 id="hero-title" class="h-display">
							Thêm chút yêu thương,
							<em>chăm bé nhẹ nhàng hơn.</em>
						</h1>
						<p>
							Molli làm những món nhỏ mẹ dùng mỗi ngày: túi trữ sữa, gạc rơ lưỡi, tăm bông, lót chống thấm,
							khăn và chăn cho bé. Chọn kỹ chất liệu, ghi rõ quy cách, giá niêm yết.
						</p>
						<div class="hero-actions">
							<a class="btn btn-main" href={CONTACT.shopee} target="_blank" rel="noopener">Mua trên Shopee ↗</a>
							<a class="btn btn-line" href="#san-pham">Xem sản phẩm</a>
						</div>
						<span class="status" id="open-status" data-open="true"><i></i><span>Tư vấn Zalo 24/7</span></span>
					</div>
					<div class="hero-art">
						<div class="hero-frame">
							<img
								src="/images/molli/tho-vay-chao.webp"
								alt="Thỏ Molli thắt nơ xanh, cười và vẫy tay chào"
								width="900"
								height="900"
								fetchpriority="high"
							/>
						</div>
						<div class="hero-chip">
							<img src={imageOf(heroProduct.code)} alt="" width="52" height="52" />
							<span>{heroProduct.name}<b>{formatPrice(heroProduct.price)}</b></span>
						</div>
					</div>
				</section>

				<div class="facts" role="list">
					<div role="listitem"><b>Hơn 50 mã</b><span>Đồ dùng cho mẹ và bé</span></div>
					<div role="listitem"><b>Tư vấn 24/7</b><span>Nhắn Zalo {formatPhone(CONTACT.zaloPhone)}</span></div>
					<div role="listitem"><b>Mua lẻ trên Shopee</b><span>Shop chính thức của Molli</span></div>
					<div role="listitem"><b>Đơn sỉ từ 1,5 triệu</b><span>Báo giá theo số lượng từng mã</span></div>
				</div>
			</div>

			<section class="sec" aria-labelledby="h-pillars">
				<div class="wrap">
					<div class="sec-head">
						<span class="kicker">Vì sao là Molli</span>
						<h2 id="h-pillars" class="h-display">Bốn điều Molli giữ trong từng món đồ</h2>
					</div>
					<div class="pillars">
						{
							pillars.map((p) => (
								<article class="pillar">
									<div class="ic" aria-hidden="true">
										{p.icon}
									</div>
									<h3>{p.title}</h3>
									<p>{p.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="sec sec-alt" id="san-pham" aria-labelledby="h-products">
				<div class="wrap">
					<div class="sec-head">
						<span class="kicker">Sản phẩm</span>
						<h2 id="h-products" class="h-display">Món mẹ hay tìm ở Molli</h2>
						<p>Chọn một nhóm để xem. Mỗi nhóm hiện vài mã tiêu biểu, đủ mã có trên shop Shopee của Molli.</p>
					</div>
					<div class="tabs" role="group" aria-label="Lọc sản phẩm theo nhóm">
						<button type="button" data-cat="featured" aria-pressed="true">Nổi bật</button>
						{
							CATEGORIES.map((c) => (
								<button type="button" data-cat={c.key} aria-pressed="false">
									{c.label}
								</button>
							))
						}
					</div>
					<div class="grid" id="product-grid">
						{
							PRODUCTS.map((p) => (
								<article class="card" data-cat={p.cat} data-featured={p.featured ? 'true' : 'false'} hidden={!p.featured}>
									<img src={imageOf(p.code)} alt={`${p.name} Molli ${p.code}`} width="560" height="560" loading="lazy" />
									<div class="card-body">
										<span class="pill">{catLabel[p.cat]}</span>
										<h3>{p.name}</h3>
										<span class="spec">{p.spec}</span>
										<div class="price">
											<b>{formatPrice(p.price)}</b>
											<small>{p.code}</small>
										</div>
									</div>
								</article>
							))
						}
					</div>
					<div class="below">
						<a class="btn btn-line" href={CONTACT.shopee} target="_blank" rel="noopener">Xem đủ sản phẩm trên Shopee ↗</a>
						<p>Giá bán lẻ khuyến nghị, cập nhật 13/11/2026. Giá trên Shopee có thể khác khi shop chạy chương trình.</p>
					</div>
				</div>
			</section>

			<section class="sec" id="goi-y" aria-labelledby="h-stages">
				<div class="wrap">
					<div class="sec-head">
						<span class="kicker">Gợi ý theo giai đoạn</span>
						<h2 id="h-stages" class="h-display">Mẹ đang ở giai đoạn nào, Molli gợi ý luôn</h2>
						<p>Chọn giai đoạn, Molli bày sẵn những món hay cần dùng cùng nhau.</p>
					</div>
					<div class="stages" role="group" aria-label="Chọn giai đoạn">
						{
							STAGES.map((s, i) => (
								<button type="button" data-stage={s.key} aria-pressed={i === 0 ? 'true' : 'false'}>
									{s.label}
								</button>
							))
						}
					</div>
					<div class="bundles">
						{
							bundles.map((b) => (
								<article class="bundle" data-stage={b.stage} hidden={b.stage !== STAGES[0].key}>
									<small>{b.note}</small>
									<h3>{b.title}</h3>
									<div class="total">
										{formatPrice(b.total)}
										<span>tổng giá lẻ {b.items.length} món</span>
									</div>
									<ul>
										{b.items.map((i) => (
											<li>
												<span>{i.name}</span>
												<span>{formatPrice(i.price)}</span>
											</li>
										))}
									</ul>
									<a class="btn btn-line" href={zaloLink} target="_blank" rel="noopener">
										Hỏi Molli về gợi ý này
									</a>
								</article>
							))
						}
					</div>
					<p class="fine">
						Đây là gợi ý gom từ các món bán lẻ, tổng tiền là giá lẻ cộng lại, chưa phải combo giảm giá. Mẹ có thể bớt
						hoặc thêm món tùy nhu cầu.
					</p>
				</div>
			</section>

			<section class="sec wholesale" id="nhap-si" aria-labelledby="h-ws">
				<div class="wrap ws-grid">
					<div>
						<span class="kicker">Nhập sỉ</span>
						<h2 id="h-ws" class="h-display">Nhập Molli về bán cho cửa hàng mẹ và bé</h2>
						<p>
							Molli làm việc trực tiếp với đại lý và cửa hàng. Giá tính theo bậc số lượng của từng mã, nhắn mã và số
							lượng dự kiến để nhận báo giá.
						</p>
						<p>
							Miền Bắc gửi xe hàng, nhận trong ngày. Miền Trung và miền Nam ưu tiên gửi SPX. Chuyển khoản tài khoản công
							ty trước khi đi hàng.
						</p>
						<a class="btn btn-main" href={zaloLink} target="_blank" rel="noopener">Nhắn Zalo nhận báo giá sỉ</a>
					</div>
					<div class="ws-stats">
						<div><b>1,5 triệu</b><span>Đơn tối thiểu, đã gồm VAT</span></div>
						<div><b>4 bậc giá</b><span>Theo số lượng từng mã</span></div>
						<div><b>10 triệu</b><span>Miễn cước giao hàng (nội thành Hà Nội từ 3 triệu)</span></div>
						<div><b>3 ngày</b><span>Đổi mới hàng lỗi, tính từ khi nhận</span></div>
					</div>
				</div>
			</section>

			<section class="sec sec-alt" id="lien-he" aria-labelledby="h-contact">
				<div class="wrap">
					<div class="sec-head">
						<span class="kicker">Liên hệ</span>
						<h2 id="h-contact" class="h-display">Cần hỏi gì, mẹ cứ nhắn Molli</h2>
					</div>
					<div class="contact">
						<a href={zaloLink} target="_blank" rel="noopener">
							<small>Tư vấn 24/7</small>
							<b>Zalo {formatPhone(CONTACT.zaloPhone)}</b>
							<span>{CONTACT.zaloLabel}</span>
						</a>
						<a href={callLink}>
							<small>Gọi trực tiếp</small>
							<b>{formatPhone(CONTACT.callPhone)}</b>
							<span>Đơn sỉ, hợp tác</span>
						</a>
						<a href={CONTACT.shopee} target="_blank" rel="noopener">
							<small>Mua lẻ</small>
							<b>Shopee Molli</b>
							<span>Ship, thanh toán, đổi trả theo Shopee</span>
						</a>
						<a href={CONTACT.tiktok} target="_blank" rel="noopener">
							<small>Xem video</small>
							<b>TikTok @mollivn</b>
							<span>Mẹo dùng đồ, mở hộp sản phẩm</span>
						</a>
					</div>
					<p class="company">
						Nhập khẩu và phân phối: {CONTACT.company}, {CONTACT.address}.
					</p>
				</div>
			</section>
		</main>
		<Footer />

		<script is:inline>
			(() => {
				// Lọc sản phẩm theo nhóm
				const tabs = document.querySelectorAll('[data-cat][aria-pressed]');
				const cards = document.querySelectorAll('#product-grid .card');
				tabs.forEach((btn) =>
					btn.addEventListener('click', () => {
						const cat = btn.dataset.cat;
						tabs.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
						cards.forEach((c) => {
							c.hidden = cat === 'featured' ? c.dataset.featured !== 'true' : c.dataset.cat !== cat;
						});
					}),
				);
				// Chọn giai đoạn
				const stages = document.querySelectorAll('.stages button');
				const bundles = document.querySelectorAll('.bundle');
				stages.forEach((btn) =>
					btn.addEventListener('click', () => {
						stages.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
						bundles.forEach((b) => (b.hidden = b.dataset.stage !== btn.dataset.stage));
					}),
				);
				// Trạng thái trực: tính theo giờ Việt Nam, người thật xử lý đơn 8h-21h
				const el = document.getElementById('open-status');
				if (el) {
					let h = new Date().getHours();
					try {
						h = Number(
							new Intl.DateTimeFormat('en-GB', { hour: '2-digit', hour12: false, timeZone: 'Asia/Ho_Chi_Minh' }).format(new Date()),
						);
					} catch {}
					const open = h >= 8 && h < 21;
					el.dataset.open = String(open);
					el.lastElementChild.textContent = open
						? 'Tư vấn Zalo 24/7 · Đang có người xử lý đơn, tới 21:00'
						: 'Tư vấn Zalo 24/7 · Đơn sẽ được xử lý từ 8:00 sáng';
				}
			})();
		</script>
	</body>
</html>
