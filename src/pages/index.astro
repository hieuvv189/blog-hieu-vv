---
// Trang chủ Molli theo bản mẫu anh Hiếu chọn (website-mau/molli-trang-chu/index.html):
// hero, nhóm sản phẩm, sản phẩm có lọc theo nhóm, chọn theo giai đoạn, bốn điều Molli giữ,
// giấy kiểm định, đại lý. Giữ giá lẻ, nhóm Địu riêng và nút giao diện Sáng/Tối dùng chung.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION } from '../consts';
import { CATEGORIES, CONTACT, PRODUCTS, STAGES, formatPrice, imageOf, zaloLink } from '../data/molli';

const catLabel = Object.fromEntries(CATEGORIES.map((c) => [c.key, c.label]));
const total = (items: { price: number }[]) => items.reduce((sum, i) => sum + i.price, 0);

const values = [
	{ icon: '🛡️', title: 'An toàn đi trước', text: 'Sản phẩm được kiểm định trước khi đến tay mẹ. Mã nào có giấy, Molli gửi để mẹ tự xem.' },
	{ icon: '💬', title: 'Nói thật về sản phẩm', text: 'Xuất xứ, chất liệu, quy cách đều ghi rõ, không nói quá công dụng.' },
	{ icon: '☁️', title: 'Chọn kỹ chất liệu', text: 'Cotton, sợi tre, muslin, bông tự nhiên, silicon. Mỗi mã ghi rõ chất liệu và độ tuổi dùng.' },
	{ icon: '📦', title: 'Đủ size, đủ quy cách', text: 'Từ hộp nhỏ dùng thử đến bịch lớn cho cả tháng, mỗi nhà chọn đúng thứ mình cần.' },
];

// Video feedback thật của khách (bản gốc trong brain: Molli/video-feedback.md), mã theo bảng video-feedback.
const feedbackVideos = [
	{ slug: 'tui-tru-sua-mol3012', label: 'Túi trữ sữa', text: 'Khoá zip đôi, có vạch chia ml, phần ghi ngày giờ trữ sữa.' },
	{ slug: 'khan-kho-mol3016', label: 'Khăn vải khô 900g', text: 'Dùng khô hay nhúng nước đều được, túi zip tiện mang theo.' },
	{ slug: 'gac-ro-luoi-mol3002', label: 'Gạc rơ lưỡi', text: 'Từng chiếc gói riêng, mẹ lấy dùng một lần là bỏ.' },
];

const papers = [
	{ code: 'MOL3002', label: 'MOL3002 Gạc rơ lưỡi', alt: 'Giấy chứng nhận hợp quy MOL3002' },
	{ code: 'MOL3012', label: 'MOL3012 Túi trữ sữa', alt: 'Phiếu kiểm nghiệm MOL3012' },
	{ code: 'MOL3013', label: 'MOL3013 Lót thấm sữa', alt: 'Phiếu thử nghiệm MOL3013' },
];
---

<!doctype html>
<html lang="vi" data-theme="light">
	<head>
		<BaseHead title="Molli - Đồ sơ sinh cho những ngày đầu đời của bé" description={SITE_DESCRIPTION} />
		<style>
			:root {
				--h: #24618f;
				--chip: #e8f3fb;
			}
			:root[data-theme='dark'] {
				--h: #cfe6f7;
				--chip: #1b3248;
			}
			main {
				background: var(--surface);
			}
			.sec {
				padding: 64px 0;
			}
			.alt {
				background: var(--bg);
			}
			.center {
				text-align: center;
			}
			.tag {
				display: inline-block;
				background: var(--chip);
				color: var(--accent);
				font-weight: 700;
				font-size: 13px;
				padding: 6px 14px;
				border-radius: 99px;
				margin-bottom: 12px;
			}
			h2.title {
				font-size: 32px;
				line-height: 1.25;
				color: var(--h);
				margin: 0 0 10px;
			}
			.lead {
				color: var(--muted);
				max-width: 640px;
				margin: 0;
			}
			.center .lead {
				margin: 0 auto;
			}
			.pill-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				padding: 12px 24px;
				border-radius: 99px;
				font-weight: 700;
				border: 2px solid var(--brand);
				text-decoration: none;
				transition: 0.2s;
			}
			.pill-btn.solid {
				background: var(--brand);
				color: #fff;
			}
			.pill-btn.solid:hover {
				background: var(--brand-deep);
				border-color: var(--brand-deep);
			}
			.pill-btn.line {
				color: var(--accent);
				background: var(--surface);
			}
			.pill-btn.line:hover {
				background: var(--chip);
			}

			/* Hero */
			.hero {
				background: linear-gradient(135deg, var(--bg) 0%, var(--tile) 100%);
				padding: 56px 0 44px;
				overflow: hidden;
			}
			.hero .wrap {
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 30px;
				align-items: center;
			}
			.hero h1 {
				font-size: 46px;
				line-height: 1.15;
				color: var(--h);
				margin: 0 0 16px;
			}
			.hero h1 span {
				color: var(--brand);
			}
			.hero p {
				font-size: 18px;
				color: var(--muted);
				margin: 0 0 26px;
				max-width: 520px;
			}
			.cta {
				display: flex;
				gap: 12px;
				flex-wrap: wrap;
			}
			.promise {
				display: flex;
				gap: 12px 28px;
				margin-top: 34px;
				flex-wrap: wrap;
				padding: 0;
				list-style: none;
			}
			.promise li {
				font-weight: 700;
				color: var(--h);
				font-size: 15px;
			}
			.promise li::before {
				content: '✓';
				display: inline-grid;
				place-items: center;
				width: 22px;
				height: 22px;
				border-radius: 50%;
				background: var(--brand);
				color: #fff;
				font-size: 12px;
				margin-right: 8px;
			}
			.hero-art {
				position: relative;
			}
			.hero-art .mascot {
				width: 100%;
				height: auto;
				border-radius: 40px;
				box-shadow: 0 20px 50px rgba(58, 135, 192, 0.25);
			}
			.hero-art .float {
				position: absolute;
				width: 150px;
				height: auto;
				border-radius: 20px;
				background: #fff;
				padding: 8px;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
			}
			.hero-art .f1 {
				left: -30px;
				bottom: 30px;
			}
			.hero-art .f2 {
				right: -14px;
				top: 30px;
			}

			/* Nhóm */
			.groups {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 18px;
				margin-top: 36px;
			}
			.group {
				background: var(--bg);
				border-radius: var(--radius);
				padding: 20px 14px;
				text-align: center;
				transition: 0.2s;
				border: 1px solid var(--line);
				text-decoration: none;
				color: inherit;
			}
			.group:hover {
				transform: translateY(-4px);
				box-shadow: 0 12px 28px rgba(58, 135, 192, 0.15);
			}
			.group img {
				width: 112px;
				height: 112px;
				object-fit: cover;
				border-radius: 50%;
				margin: 0 auto 14px;
				border: 4px solid var(--surface);
				display: block;
			}
			.group h3 {
				font-size: 17px;
				color: var(--h);
				margin: 0 0 4px;
			}
			.group p {
				font-size: 14px;
				color: var(--muted);
				margin: 0;
				line-height: 1.5;
			}

			/* Sản phẩm */
			.filters {
				display: flex;
				gap: 10px;
				justify-content: center;
				flex-wrap: wrap;
				margin: 28px 0;
			}
			.filters button {
				border: 1.5px solid var(--line);
				background: var(--surface);
				color: var(--ink);
				padding: 8px 18px;
				border-radius: 99px;
				font: inherit;
				font-weight: 600;
				cursor: pointer;
			}
			.filters button[aria-pressed='true'] {
				background: var(--brand);
				border-color: var(--brand);
				color: #fff;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 20px;
			}
			.card {
				border: 1px solid var(--line);
				border-radius: var(--radius);
				overflow: hidden;
				background: var(--surface);
				display: flex;
				flex-direction: column;
				transition: 0.2s;
			}
			.card[hidden] {
				display: none;
			}
			.card:hover {
				box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
			}
			.card img {
				aspect-ratio: 1;
				object-fit: cover;
				width: 100%;
				height: auto;
				display: block;
			}
			.card-body {
				padding: 14px 16px 16px;
				display: flex;
				flex-direction: column;
				flex: 1;
			}
			.code {
				font-size: 12px;
				font-weight: 700;
				color: var(--accent);
				letter-spacing: 0.5px;
			}
			.card h3 {
				font-size: 16px;
				margin: 4px 0 2px;
				line-height: 1.35;
			}
			.spec {
				font-size: 13px;
				color: var(--muted);
			}
			.note {
				font-size: 13.5px;
				color: var(--muted);
				flex: 1;
				margin: 6px 0 0;
				line-height: 1.5;
			}
			.price {
				font-size: 18px;
				font-weight: 800;
				color: var(--price);
				margin-top: 10px;
			}
			.card-actions {
				display: flex;
				gap: 8px;
				margin-top: 10px;
			}
			.card-actions a {
				flex: 1;
				text-align: center;
				font-size: 13px;
				font-weight: 700;
				padding: 8px;
				border-radius: 10px;
				text-decoration: none;
			}
			.card-actions .z {
				background: var(--brand);
				color: #fff;
			}
			.card-actions .s {
				background: #fff1ec;
				color: #d6461f;
			}
			.price-note {
				text-align: center;
				color: var(--muted);
				font-size: 14px;
				margin: 24px auto 0;
				max-width: 640px;
			}

			/* Giai đoạn */
			.stages {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 20px;
				margin-top: 36px;
			}
			.stage {
				background: var(--surface);
				border-radius: var(--radius);
				padding: 22px;
				border-top: 5px solid var(--brand);
				display: flex;
				flex-direction: column;
			}
			.stage .step {
				font-size: 13px;
				font-weight: 800;
				color: var(--price);
				text-transform: uppercase;
			}
			.stage h3 {
				color: var(--h);
				font-size: 19px;
				margin: 6px 0 10px;
			}
			.stage ul {
				list-style: none;
				font-size: 14px;
				color: var(--muted);
				flex: 1;
				padding: 0;
				margin: 0;
			}
			.stage li {
				display: flex;
				align-items: center;
				gap: 10px;
				padding: 6px 0;
				border-bottom: 1px dashed var(--line);
				line-height: 1.4;
				color: var(--ink);
			}
			.stage li img {
				flex: none;
				width: 36px;
				height: 36px;
				object-fit: contain;
				background: #fff;
				border-radius: 8px;
				border: 1px solid var(--line);
				padding: 2px;
			}
			.stage .sum {
				margin: 12px 0 0;
				font-size: 14px;
				color: var(--muted);
			}
			.stage .sum b {
				color: var(--price);
				font-size: 16px;
			}
			.stage .pill-btn {
				margin-top: 14px;
				font-size: 14px;
				padding: 10px;
			}

			/* Video feedback */
			.videos {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 24px;
				margin-top: 36px;
			}
			.video-card {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: var(--radius);
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}
			.video-card video {
				display: block;
				width: 100%;
				aspect-ratio: 9 / 16;
				object-fit: cover;
				background: var(--chip);
			}
			.video-card .vlabel {
				display: inline-block;
				margin: 14px 18px 0;
				font-size: 13px;
				font-weight: 700;
				color: var(--accent);
			}
			.video-card p {
				margin: 4px 18px 18px;
				font-size: 15px;
				color: var(--muted);
			}
			@media (max-width: 860px) {
				.videos {
					grid-template-columns: none;
					grid-auto-flow: column;
					grid-auto-columns: 72%;
					overflow-x: auto;
					scroll-snap-type: x mandatory;
					padding-bottom: 8px;
				}
				.video-card {
					scroll-snap-align: start;
				}
			}

			/* Bốn điều */
			.values {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 20px;
				margin-top: 36px;
			}
			.values > div {
				padding: 24px;
				border-radius: var(--radius);
				background: var(--surface);
				border: 1px solid var(--line);
			}
			.values .ic {
				font-size: 30px;
				margin-bottom: 10px;
			}
			.values h3 {
				color: var(--h);
				font-size: 18px;
				margin: 0 0 6px;
			}
			.values p {
				font-size: 14.5px;
				color: var(--muted);
				margin: 0;
				line-height: 1.6;
			}

			/* Giấy kiểm định */
			.papers-wrap {
				display: grid;
				grid-template-columns: 1fr 1.3fr;
				gap: 40px;
				align-items: center;
			}
			.papers {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 14px;
			}
			.papers button {
				all: unset;
				background: #fff;
				border-radius: 14px;
				padding: 8px;
				box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
				cursor: zoom-in;
				text-align: center;
			}
			.papers button:focus-visible {
				outline: 3px solid var(--focus);
			}
			.papers img {
				aspect-ratio: 3/4;
				object-fit: cover;
				object-position: top;
				border-radius: 8px;
				width: 100%;
				height: auto;
				display: block;
			}
			.papers span {
				display: block;
				font-size: 12px;
				color: #5f7486;
				margin-top: 6px;
				font-weight: 600;
			}
			#lightbox {
				position: fixed;
				inset: 0;
				background: rgba(10, 25, 40, 0.85);
				display: none;
				place-items: center;
				z-index: 80;
				cursor: zoom-out;
			}
			#lightbox.open {
				display: grid;
			}
			#lightbox img {
				max-height: 90vh;
				max-width: 94vw;
				border-radius: 10px;
			}

			/* Đại lý */
			.dealer {
				background: linear-gradient(135deg, #3a87c0 0%, #24618f 100%);
				color: #fff;
				border-radius: 28px;
				padding: 44px;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 40px;
				align-items: center;
			}
			.dealer .tag {
				background: rgba(255, 255, 255, 0.18);
				color: #fff;
			}
			.dealer h2.title {
				color: #fff;
			}
			.dealer .lead {
				color: #dcecf9;
			}
			.dealer ul {
				list-style: none;
				margin: 18px 0 0;
				padding: 0;
			}
			.dealer ul li {
				padding: 4px 0;
			}
			.dealer ul li::before {
				content: '✓ ';
				font-weight: 800;
			}
			.dealer-box {
				background: #fff;
				border-radius: 20px;
				padding: 26px;
				color: #22313f;
			}
			.dealer-box h3 {
				color: #24618f;
				margin: 0 0 8px;
			}
			.dealer-box p {
				color: #5f7486;
				margin: 0 0 16px;
				font-size: 15px;
			}
			.dealer-box ol {
				margin: 0 0 20px;
				padding-left: 20px;
				color: #22313f;
				font-size: 15px;
			}
			.dealer-box .pill-btn {
				width: 100%;
			}

			@media (max-width: 1000px) {
				.groups {
					grid-template-columns: repeat(3, 1fr);
				}
			}
			@media (max-width: 900px) {
				.hero .wrap,
				.papers-wrap,
				.dealer {
					grid-template-columns: 1fr;
				}
				.hero h1 {
					font-size: 34px;
				}
				.grid,
				.stages,
				.values {
					grid-template-columns: repeat(2, 1fr);
				}
				.hero-art .float {
					width: 110px;
				}
				.hero-art .f1 {
					left: 0;
				}
				.hero-art .f2 {
					right: 0;
				}
				.dealer {
					padding: 28px;
				}
				h2.title {
					font-size: 26px;
				}
				.sec {
					padding: 48px 0;
				}
			}
			@media (max-width: 560px) {
				.groups {
					grid-template-columns: repeat(2, 1fr);
				}
				.stages,
				.values {
					grid-template-columns: 1fr;
				}
				.grid {
					gap: 12px;
				}
				.card-body {
					padding: 12px;
				}
				.card-actions {
					flex-direction: column;
				}
			}
		</style>
	</head>
	<body>
		<Header active="home" />
		<main id="noi-dung">
			<section class="hero" aria-labelledby="hero-title">
				<div class="wrap">
					<div>
						<span class="tag">Đồ sơ sinh cho mẹ và bé</span>
						<h1 id="hero-title">Mềm mại như vòng tay mẹ, <span>cho những ngày đầu đời của con</span></h1>
						<p>
							Từ chiếc túi đi sinh đến những bữa ăn dặm đầu tiên, Molli chuẩn bị đủ những món bé cần, để mẹ yên tâm chăm con.
						</p>
						<div class="cta">
							<a class="pill-btn solid" href="#san-pham">Xem sản phẩm</a>
							<a class="pill-btn line" href={zaloLink} target="_blank" rel="noopener">Nhắn Zalo tư vấn</a>
						</div>
						<ul class="promise">
							<li>Giấy kiểm định theo mã</li>
							<li>Đổi mới hàng lỗi trong 3 ngày</li>
							<li>Tư vấn 24/7</li>
						</ul>
					</div>
					<div class="hero-art">
						<img
							class="mascot"
							src="/images/molli/tho-hero.webp"
							alt="Thỏ Molli thắt nơ xanh, ôm trái tim và vẫy tay chào"
							width="900"
							height="900"
							fetchpriority="high"
						/>
						<img class="float f1" src={imageOf('MOL3012')} alt="Túi trữ sữa Molli" width="560" height="560" />
						<img class="float f2" src={imageOf('MOL3002')} alt="Gạc rơ lưỡi Molli" width="560" height="560" />
					</div>
				</div>
			</section>

			<section class="sec" aria-labelledby="h-groups">
				<div class="wrap center">
					<span class="tag">Danh mục</span>
					<h2 id="h-groups" class="title">Mẹ đang tìm gì cho bé?</h2>
					<p class="lead">Năm nhóm sản phẩm theo đúng những việc mẹ làm mỗi ngày.</p>
					<div class="groups">
						{
							CATEGORIES.map((c) => (
								<a class="group" href={`?nhom=${c.key}#san-pham`} data-group={c.key}>
									<img src={imageOf(c.cover)} alt="" width="560" height="560" loading="lazy" />
									<h3>{c.label}</h3>
									<p>{c.desc}</p>
								</a>
							))
						}
					</div>
				</div>
			</section>

			<section class="sec" id="san-pham" style="padding-top:0" aria-labelledby="h-products">
				<div class="wrap center">
					<span class="tag">Sản phẩm</span>
					<h2 id="h-products" class="title">Được các mẹ chọn nhiều</h2>
					<div class="filters" role="group" aria-label="Lọc sản phẩm theo nhóm">
						<button type="button" data-cat="featured" aria-pressed="true">Nổi bật</button>
						{
							CATEGORIES.map((c) => (
								<button type="button" data-cat={c.key} aria-pressed="false">
									{c.label}
								</button>
							))
						}
					</div>
				</div>
				<div class="wrap grid" id="product-grid">
					{
						PRODUCTS.map((p) => (
							<article class="card" data-cat={p.cat} data-featured={p.featured ? 'true' : 'false'} hidden={!p.featured}>
								<img src={imageOf(p.code)} alt={`${p.name} Molli ${p.code}`} width="560" height="560" loading="lazy" />
								<div class="card-body">
									<span class="code">
										{p.code} · {catLabel[p.cat]}
									</span>
									<h3>{p.name}</h3>
									<span class="spec">{p.spec}</span>
									<p class="note">{p.note}</p>
									<div class="price">{formatPrice(p.price)}</div>
									<div class="card-actions">
										<a class="z" href={zaloLink} target="_blank" rel="noopener">
											Tư vấn Zalo
										</a>
										<a class="s" href={CONTACT.shopee} target="_blank" rel="noopener">
											Shopee
										</a>
									</div>
								</div>
							</article>
						))
					}
				</div>
				<p class="price-note">Giá bán lẻ khuyến nghị, cập nhật 13/11/2026. Giá trên Shopee có thể khác khi shop chạy chương trình.</p>
			</section>

			<section class="sec alt" id="giai-doan" aria-labelledby="h-stages">
				<div class="wrap center">
					<span class="tag">Chọn theo giai đoạn</span>
					<h2 id="h-stages" class="title">Mẹ đang ở chặng nào?</h2>
					<p class="lead">Mỗi chặng một danh sách gợi ý, mẹ không phải tự nghĩ xem còn thiếu gì.</p>
				</div>
				<div class="wrap stages">
					{
						STAGES.map((s) => (
							<article class="stage">
								<span class="step">{s.step}</span>
								<h3>{s.title}</h3>
								<ul>
									{s.items.map((i) => (
										<li>
											<img src={imageOf(i.code)} alt="" width="36" height="36" loading="lazy" />
											<span>{i.name}</span>
										</li>
									))}
								</ul>
								<p class="sum">
									Giá lẻ cộng lại: <b>{formatPrice(total(s.items))}</b>
								</p>
								<a class="pill-btn line" href={zaloLink} target="_blank" rel="noopener">
									Tư vấn trọn bộ
								</a>
							</article>
						))
					}
				</div>
			</section>

			<section class="sec" id="video-feedback" aria-labelledby="h-videos">
				<div class="wrap center">
					<span class="tag">Mẹ nói gì về Molli</span>
					<h2 id="h-videos" class="title">Video thật từ các mẹ đã dùng</h2>
					<p class="lead">Các mẹ tự quay khi nhận hàng và dùng ở nhà. Bấm vào video để xem, có tiếng.</p>
				</div>
				<div class="wrap videos">
					{
						feedbackVideos.map((v) => (
							<article class="video-card">
								<video
									src={`/videos/feedback/${v.slug}.mp4`}
									poster={`/videos/feedback/${v.slug}.webp`}
									controls
									playsinline
									preload="none"
									aria-label={`Video feedback ${v.label} Molli`}
								/>
								<span class="vlabel">{v.label}</span>
								<p>{v.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="sec" id="cau-chuyen" aria-labelledby="h-values">
				<div class="wrap center">
					<span class="tag">Câu chuyện Molli</span>
					<h2 id="h-values" class="title">Bốn điều Molli giữ trong từng sản phẩm</h2>
					<p class="lead">
						Molli là thương hiệu đồ sơ sinh do {CONTACT.company} phát triển và phân phối.
						<a href="/about/" style="color:var(--accent);font-weight:700">Đọc câu chuyện Molli →</a>
					</p>
				</div>
				<div class="wrap values">
					{
						values.map((v) => (
							<div>
								<div class="ic" aria-hidden="true">
									{v.icon}
								</div>
								<h3>{v.title}</h3>
								<p>{v.text}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="sec alt" aria-labelledby="h-papers">
				<div class="wrap papers-wrap">
					<div>
						<span class="tag">Minh bạch</span>
						<h2 id="h-papers" class="title">Giấy kiểm định, mẹ xem tận mắt</h2>
						<p class="lead">
							Giấy chứng nhận hợp quy và phiếu thử nghiệm của các mã có giấy. Bấm vào ảnh để phóng to, cần giấy của mã khác thì nhắn Molli.
						</p>
						<p style="margin-top:20px">
							<a class="pill-btn solid" href={zaloLink} target="_blank" rel="noopener">Xin giấy kiểm định theo mã</a>
						</p>
					</div>
					<div class="papers">
						{
							papers.map((p) => (
								<button type="button" data-full={`/images/molli/giay/${p.code.toLowerCase()}.webp`} aria-label={`Phóng to ${p.alt}`}>
									<img src={`/images/molli/giay/${p.code.toLowerCase()}.webp`} alt={p.alt} width="400" height="533" loading="lazy" />
									<span>{p.label}</span>
								</button>
							))
						}
					</div>
				</div>
			</section>

			<section class="sec" id="dai-ly" aria-labelledby="h-dealer">
				<div class="wrap">
					<div class="dealer">
						<div>
							<span class="tag">Dành cho cửa hàng</span>
							<h2 id="h-dealer" class="title">Mở cửa hàng mẹ và bé? Nhập Molli</h2>
							<p class="lead">Nhắn Molli qua Zalo, Molli gửi bảng giá theo bậc số lượng và tư vấn mã phù hợp với khu vực của anh chị.</p>
							<ul>
								<li>Giá theo bậc số lượng từng mã, đơn tối thiểu 1,5 triệu</li>
								<li>Miễn cước từ 10 triệu (nội thành Hà Nội từ 3 triệu)</li>
								<li>Miền Bắc gửi xe trong ngày, miền Trung và Nam đi SPX</li>
								<li>Hàng lỗi đổi mới trong 3 ngày</li>
							</ul>
						</div>
						<div class="dealer-box">
							<h3>Nhận bảng giá đại lý</h3>
							<p>Nhắn Zalo cho Molli, ghi sẵn ba ý sau để được báo giá nhanh:</p>
							<ol>
								<li>Tên cửa hàng và tỉnh, thành phố</li>
								<li>Các mã anh chị muốn nhập</li>
								<li>Số lượng dự kiến của từng mã</li>
							</ol>
							<a class="pill-btn solid" href={zaloLink} target="_blank" rel="noopener">Nhắn Zalo nhận bảng giá</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<div id="lightbox" role="dialog" aria-modal="true" aria-label="Ảnh giấy kiểm định"><img alt="" /></div>

		<script is:inline>
			(() => {
				// Lọc sản phẩm theo nhóm, mở đúng nhóm khi vào bằng ?nhom=<nhóm>
				const tabs = [...document.querySelectorAll('.filters button')];
				const cards = document.querySelectorAll('#product-grid .card');
				const pick = (cat) => {
					const btn = tabs.find((b) => b.dataset.cat === cat) || tabs[0];
					tabs.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
					cards.forEach((c) => {
						c.hidden = btn.dataset.cat === 'featured' ? c.dataset.featured !== 'true' : c.dataset.cat !== btn.dataset.cat;
					});
				};
				tabs.forEach((b) => b.addEventListener('click', () => pick(b.dataset.cat)));
				document.querySelectorAll('.group').forEach((a) =>
					a.addEventListener('click', (e) => {
						e.preventDefault();
						pick(a.dataset.group);
						history.replaceState(null, '', `?nhom=${a.dataset.group}#san-pham`);
						document.getElementById('san-pham').scrollIntoView({ behavior: 'smooth' });
					}),
				);
				const start = new URLSearchParams(location.search).get('nhom');
				if (start) pick(start);

				// Phóng to giấy kiểm định
				const box = document.getElementById('lightbox');
				const boxImg = box.querySelector('img');
				document.querySelectorAll('.papers button').forEach((b) =>
					b.addEventListener('click', () => {
						boxImg.src = b.dataset.full;
						boxImg.alt = b.querySelector('img').alt;
						box.classList.add('open');
					}),
				);
				box.addEventListener('click', () => box.classList.remove('open'));
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') box.classList.remove('open');
				});
			})();
		</script>
	</body>
</html>
